# Copy to .env (git-ignored) and fill in. Used by `npm run start:env -w @restorelab/api`.
PORT=4000
STORE=surreal

# Local: SURREAL_URL=ws://127.0.0.1:8000/rpc with root/root.
# Surreal Cloud: the instance's endpoint from the Cloud dashboard / Surrealist, e.g.
#   wss://<instance-id>.aws-euw1.surreal.cloud/rpc
SURREAL_URL=wss://YOUR-INSTANCE.surreal.cloud/rpc
SURREAL_USER=
SURREAL_PASS=
# Level the user above is defined on: root | namespace | database
SURREAL_AUTH_LEVEL=root
SURREAL_NS=restorelab
SURREAL_DB=api
