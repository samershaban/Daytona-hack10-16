# Copy to .env (git-ignored) and fill in. Used by `npm run start:env -w @restorelab/api`.

# ---------- API server ----------
PORT=4000
# memory | jsonl | surreal
STORE=surreal

# ---------- API database (runs, findings, verdicts) ----------
# A SurrealDB instance you can query directly, NOT Agent Memory.
# Local: surreal start --user root --pass root rocksdb:.data/surreal.db  ->  ws://127.0.0.1:8000/rpc, root/root
# Surreal Cloud instance: wss://<instance-id>.<region>.surreal.cloud/rpc with a user you DEFINE USER yourself.
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
# Level the user above is defined on: root | namespace | database
SURREAL_AUTH_LEVEL=root
SURREAL_NS=restorelab
SURREAL_DB=api

# ---------- SurrealDB Agent Memory (Spectron Cloud) ----------
# Hosted agent memory. Auth is an API key only (Authorization: Bearer sp-...), from SurrealDB Studio > API keys.
AGENT_MEMORY_URL=https://<your-instance>.spectron.<region>.surreal.cloud
AGENT_MEMORY_MCP_URL=https://<your-instance>.spectron.<region>.surreal.cloud/mcp
AGENT_MEMORY_API_KEY=
AGENT_MEMORY_CONTEXT_ID=
AGENT_MEMORY_ORG_ID=
